{
  "id": "caffeine-tracker",
  "name": "Caffeine Tracker",
  "version": "1.54.1",
  "description": "Log caffeine intake and simulate blood caffeine level decay over time using a half-life model",
  "manifestVersion": 1,
  "minSupVersion": "18.8.0",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": false,
  "uiKit": true,
  "isSkipMenuEntry": true,
  "permissions": [
    "registerHeaderButton",
    "showIndexHtmlAsView",
    "persistDataSynced",
    "loadSyncedData",
    "showSnack",
    "getTasks",
    "getArchivedTasks",
    "getAllCounters",
    "getAllTags",
    "http"
  ],
  "allowedHosts": ["api.github.com"],
  "hooks": ["persistedDataChanged", "anyTaskUpdate", "action"]
}
